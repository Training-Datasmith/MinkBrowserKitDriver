<?xml version="1.0" encoding="UTF-8"?>

<phpunit colors="true" bootstrap="vendor/autoload.php">
    <php>
        <var name="driver_config_factory" value="Behat\Mink\Tests\Driver\Http_Client_Browser_Kit_Config::getInstance" />
    </php>

    <testsuites>
        <testsuite name="Driver test suite">
            <directory>tests</directory>
            <directory>vendor/mink/driver-testsuite/tests/Basic</directory>
            <directory>vendor/mink/driver-testsuite/tests/Form</directory>
        </testsuite>
    </testsuites>

    <filter>
        <whitelist>
            <directory>./src</directory>
        </whitelist>
    </filter>

    <listeners>
        <listener class="Symfony\Bridge\Php_Unit\Symfony_Tests_Listener"/>
    </listeners>
</phpunit>
